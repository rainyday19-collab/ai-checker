# Safe development default. Set openai explicitly to enable paid grading requests.
GRADING_MODE=mock

# Credentials are only required in openai mode. Never commit your real .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional deployed frontend origin for CORS. Do not include a path.
FRONTEND_ORIGIN=https://your-frontend.example.com
